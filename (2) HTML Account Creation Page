<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Portfolio Professionals / Create Account</title>
    <link rel="stylesheet" href="style1.css"> 
    <link rel="stylesheet" href="create_acc.css">

    <style>

      body {
        color: #480061;
        font-family: Verdana; 
      }
      
    </style>
    
    <!-- metadata telling the browser information about the website -->

    <meta name="description" content="Website page for individuals to create an account, with pre-existing and new information. Information given is recorded, saved, and referenced to match with sign-in credentials.">
    <meta name="keywords" content="First name, Last name, User name, Email, Password.">
	  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
</head>

<body>

    <h1>Create Your Account</h1>

    <!-- Prompts for user credentials -->

    <form action="create_account.html" method="GET">

      <!-- First Name -->
      <label for="first_name">First Name:</label>
      <input type="text" id="first_name" name="first_name" placeholder="e.g. John" required>
      <br>

      <!-- Last Name --> 
      <label for="last_name">Last Name:</label>
      <input type="text" id="last_name" name="last_name" placeholder="e.g Doe" required>
      <br>

      <!-- Username -->
      <label for="username">User name:</label>
      <input type="text" id="username" name="username" placeholder="e.g. JDoe05_" required>
      <br>

      <!-- Email -->
      <label for="eMAil">Email Address:</label>
      <input type="text" id="eMail" name="eMail" placeholder="e.g. JohnDoe@gmail.com" required>
      <br>

      <!-- Password -->
      <label for="password">Password:</label>
      <input type="password" id="password" name="password" required>
      <br>

      <!-- Verify Password -->
      <label for="v_password">Verify Password:</label>
      <input type="password" id="v_password" name="v_password" required>
      <br>

      <!-- Reset/Submit buttons -->
      <input type="reset" value="Reset">
      <input type="submit" value="Submit">

    </form>

    <!-- Link to Sign In page -->
    <a href="sign_in.html">Have an account? Sign in</a>
    <br>
    <a href="index.html">Return to home page</a>

</body>
</html>


    
